# GEMINI_API_KEY: Chave da API para o chat de acolhimento da Sophia (/api/assistant) e transcrição de microfone (/api/transcribe).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Integração exclusiva de voz da Shopia (único provedor de TTS do sistema)
SHOPIA_TTS_API_URL="MY_SHOPIA_TTS_API_URL"
SHOPIA_TTS_API_KEY="MY_SHOPIA_TTS_API_KEY"
SHOPIA_VOICE_ID="MY_SHOPIA_VOICE_ID"
SHOPIA_TTS_MODEL=""

# APP_URL: URL onde a aplicação está publicada.
APP_URL="MY_APP_URL"
