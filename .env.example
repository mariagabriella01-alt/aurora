# GOOGLE_API_KEY / GEMINI_API_KEY: Chave secreta da API Gemini (Google AI Studio).
# Configure nas variáveis de ambiente da Vercel ou nos Secrets do AI Studio. Nunca exponha no frontend.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CUSTOM_VOICE_ID: Identificador da sua voz replicada criada no Google AI Studio (ex.: voice_... ou voicekey_...).
GOOGLE_CUSTOM_VOICE_ID="MY_CUSTOM_VOICE_ID"

# GOOGLE_TTS_MODEL: Modelo Gemini TTS compatível com Voice Replication (padrão: gemini-3.8-flash-tts).
GOOGLE_TTS_MODEL="gemini-3.8-flash-tts"

# APP_URL: URL onde a aplicação está publicada.
APP_URL="MY_APP_URL"
